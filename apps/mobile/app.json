{
  "expo": {
    "name": "GREFA Tareas",
    "slug": "grefa-tareas",
    "version": "0.1.25",
    "orientation": "default",
    "scheme": "grefa-tareas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F6B3A"
    },
    "android": {
      "package": "org.grefa.tareas",
      "versionCode": 25,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6B3A"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
