{
  "name": "@grefa/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-apk-local.ps1",
    "build:apk:eas": "eas build -p android --profile preview",
    "build:aab:eas": "eas build -p android --profile production",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@grefa/firebase": "*",
    "@grefa/shared": "*",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-status-bar": "~2.0.1",
    "firebase": "^11.6.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.8.2"
  }
}
